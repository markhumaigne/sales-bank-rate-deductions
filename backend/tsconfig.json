{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "moduleResolution": "node", "outDir": "dist", "rootDir": "..",
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "esModuleInterop": true,
    "resolveJsonModule": true, "strict": true, "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
